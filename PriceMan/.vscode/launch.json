    "version": "0.2.0",
    "configurations": [
        {
            "name": "gcc - Build and debug program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/priceman",
            //"args": ["add", "Rosh Ain", "5.7"],
            //"args": ["remove", "Rosh Ain"],
            //"args": ["add", "Herzlya", "6.7"],
            //"args": ["remove", "Herzlya"],
            //"args": ["add", "Rishon Le Tsion", "5.75"],
            //"args": ["remove", "Rishon Le Tsion"],
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gcc build program"
        }
    ]
}