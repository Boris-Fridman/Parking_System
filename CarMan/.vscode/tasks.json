                "-g",
                "-std=c99",
                "-pedantic",
                "-Wall",
                "-Wextra",
                "-D_GNU_SOURCE",
                "-DBEAGLE_BONE",
                "${workspaceFolder}/../Common_Libs/CommonData.c",
                "*.c",
                "-o",
                "${workspaceFolder}/carman",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/../Common_Libs",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Cross Compiling Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-13 build active file",
            "command": "/usr/bin/gcc-13",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
