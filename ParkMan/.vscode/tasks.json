{
    "tasks": [
        {
            "type": "cppbuild",

            //task label (used in launch.json -> configrations -> preLaunchTask):
            "label": "build all",

            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                //"-O3",

                //treat warnings as errors:
                //"-Werror",

                //recommended warning flags for compilation:
                "-Wall",
                "-Wextra",
                "-Weffc++",
                 //enforce standard (no compiler specific features allowed):
                "-pedantic",

                //standard:
                "-std=c++20",//"-std=c++17",
                
                //defines
                "-D_GNU_SOURCE",
                "-D_POSIX_C_SOURCE = 1",
                "-DNET_PRINT_ERRORS",
                "-DNET_PRINT_SUCCESS",

                //source file - use all top level .c files:
                "${workspaceFolder}/../Common_Libs/CommonData.c",
                "${workspaceFolder}/../Common_Libs/DataBase/PriceDataBase.c",
                "${workspaceFolder}/../Common_Libs/Configuration/ConfMan.c",
                "${workspaceFolder}/../Common_Libs/Logging/Logging.c",

                //source file - use all top level .cpp files:
                "*.cpp",
                
                //outputfile - always "program" at workspace directory:
                "-o",
                "parkman",

                // Include Directories
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/../Common_Libs",
                "-I${workspaceFolder}/../Common_Libs/DataBase",
                "-I${workspaceFolder}/../Common_Libs/Configuration",
                "-I${workspaceFolder}/../Common_Libs/Logging",
                "-I/usr/include/gdal",

                //implementing database:
                "-lsqlite3",  // Required for sqlite database library.
                "-lgdal",     // Required for step files library.
                "-licuuc",
                "-licui18n",
                "-lrt"
                

            ],
            "options": {
                //working directory for compilation:
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
