{
    "tasks": [
        {
            "type": "cppbuild",

            //task label (used in launch.json -> configrations -> preLaunchTask):
            "label": "build all",

            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                
                //recommended warning flags for compilation:
                "-Wall",
                "-Wextra",
                "-Weffc++",
                "-pedantic",
                "-std=c++17",
                
                //defines
                "-D_GNU_SOURCE",

                //source file - use all top level .c files:
                "${workspaceFolder}/../Common_Libs/CommonData.c",

                //source file - use all top level .cpp files:
                "*.cpp",
                
                //outputfile - always "program" at workspace directory:
                "-o",
                "program",

                // Include Directories
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/../Common_Libs"
            ],
            "options": {
                //working directory for compilation:
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
